plugins {
    id "com.android.application"
}

android {
    namespace "com.catatankas.app"
    compileSdk 35

    defaultConfig {
        applicationId "com.catatankas.app"
        minSdk 24
        targetSdk 35
        versionCode 24
        versionName "1.0.1"
    }
}

dependencies {
    implementation "androidx.appcompat:appcompat:1.7.0"
    implementation "androidx.webkit:webkit:1.13.0"
    implementation "androidx.core:core:1.16.0"
}
